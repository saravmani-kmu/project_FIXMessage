<Window x:Class="FIXMessageParser.TableViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIX Message Table View" Height="600" Width="1200"
        Background="#F0F2F5" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#006CBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F2FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BEE3F8"/>
                    <Setter Property="BorderBrush" Value="#63B3ED"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#2D3748" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <TextBlock Text="FIX Message Table View  —  each message = row, each tag = column"
                       Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Border>

        <!-- Input area -->
        <Border Grid.Row="1" Background="White" CornerRadius="6"
                BorderBrush="#CBD5E0" BorderThickness="1" Margin="0,0,0,8">
            <Grid>
                <TextBox x:Name="InputTextBox"
                         AcceptsReturn="True" AcceptsTab="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         Padding="10" Background="Transparent"
                         BorderThickness="0"
                         TextChanged="InputTextBox_TextChanged"/>
                <TextBlock x:Name="PlaceholderText"
                           Text="Paste multiple FIX messages here (one per line)..."
                           Foreground="#A0AEC0" FontFamily="Consolas" FontSize="12"
                           Padding="12,14,0,0" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="  Parse  " Margin="0,0,8,0"
                    Style="{StaticResource PrimaryBtn}"
                    Click="ParseButton_Click"/>
            <Button Content="  Clear  " Margin="0,0,8,0"
                    Style="{StaticResource SecondaryBtn}"
                    Click="ClearButton_Click"/>
            <Button Content="Copy as CSV" Margin="0,0,16,0"
                    Style="{StaticResource OutlineBtn}"
                    Click="CopyButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="#718096" FontSize="12"/>
        </WrapPanel>

        <!-- Results DataGrid — columns auto-generated from DataTable -->
        <Border Grid.Row="3" Background="White" CornerRadius="6"
                BorderBrush="#CBD5E0" BorderThickness="1">
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#EDF2F7"
                      VerticalGridLinesBrush="#EDF2F7"
                      SelectionMode="Extended"
                      SelectionUnit="Cell"
                      ClipboardCopyMode="ExcludeHeader"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      RowHeight="26"
                      BorderThickness="0"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn"
                      PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown">

                <DataGrid.ContextMenu>
                    <ContextMenu Style="{x:Null}" Opened="GridContextMenu_Opened">
                        <MenuItem Header="Copy Cell" Click="MenuCopyCell_Click"/>
                        <MenuItem Header="Copy Row (Tab-separated)" Click="MenuCopyRow_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Margin="0,6,0,0">
            <TextBlock x:Name="FooterText" Foreground="#A0AEC0" FontSize="11"
                       Text="Ready — paste messages above and click Parse"/>
        </Border>
    </Grid>
</Window>
